{
  "name": "pi-deepseek-search",
  "version": "0.1.0",
  "description": "Switchable DeepSeek and OpenAI Codex web search and page retrieval for Pi. Reuses Pi's Codex login.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingdinglz/pi-deepseek-search.git"
  },
  "homepage": "https://github.com/dingdinglz/pi-deepseek-search#readme",
  "bugs": { "url": "https://github.com/dingdinglz/pi-deepseek-search/issues" },
  "keywords": ["pi-package", "pi-extension", "pi-coding-agent", "deepseek", "deepseek-api", "web-search", "web-fetch", "markdown", "typescript"],
  "files": ["index.ts", "src", "README.md"],
  "pi": { "extensions": ["./index.ts"] },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:live": "tsx scripts/smoke.ts",
    "test:live:openai": "tsx scripts/smoke-openai.ts"
  },
  "engines": { "node": ">=22" },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typebox": "^1.4.2",
    "typescript": "^5.9.0"
  }
}
